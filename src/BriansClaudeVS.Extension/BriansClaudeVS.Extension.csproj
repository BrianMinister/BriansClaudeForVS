<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- VSIX extensions target net472 for the VS extension host -->
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <RootNamespace>BriansClaudeVS</RootNamespace>
    <AssemblyName>BriansClaudeVS.Extension</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- VS SDK meta-package — update version to match your VS 2026 installation -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31902.203" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Roslyn for CodeRefactoringProvider -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.*" />
    <!-- Markdown rendering in chat window -->
    <PackageReference Include="Markdig" Version="0.38.*" />
    <!-- Core project reference -->
    <ProjectReference Include="..\BriansClaudeVS.Core\BriansClaudeVS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="VSPackage.vsct">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

</Project>
