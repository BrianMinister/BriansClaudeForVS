<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="BriansClaudeVS.DE73F1AB-E288-45B5-956D-0F9CC77A3B2A"
              Version="1.0.0"
              Language="en-US"
              Publisher="BrianProgrammer"/>
    <DisplayName>Brian's Claude for Visual Studio</DisplayName>
    <Description xml:space="preserve">
      Replaces GitHub Copilot with Claude (Anthropic) as your primary AI assistant in Visual Studio.
      Provides inline code completions, a chat window, slash commands, and lightbulb code actions.
      Bring your own Anthropic API key — configured via Tools &gt; Options &gt; Brian's Claude.
    </Description>
    <GettingStartedGuide>https://github.com/BrianProgrammer/BriansClaudeForVS#getting-started</GettingStartedGuide>
    <Icon>Resources\ClaudeIcon.png</Icon>
    <PreviewImage>assets\preview.png</PreviewImage>
    <Tags>AI, Claude, Anthropic, Code Completion, Chat, Copilot Replacement</Tags>
  </Metadata>

  <Installation>
    <!-- 18.0 floor: the extension targets .NET 10 and the 18.x SDK, so it requires VS 2026+ -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[18.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[18.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>

  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework 4.7.2 or later"
                d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>

  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[18.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>

  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="BriansClaudeVS.Extension.pkgdef"/>
  </Assets>
</PackageManifest>
