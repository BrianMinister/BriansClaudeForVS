<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BriansClaudeVS.Core</RootNamespace>
    <AssemblyName>BriansClaudeVS.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Anthropic .NET SDK -->
    <PackageReference Include="Anthropic" Version="12.29.0" />
    <!-- DPAPI wrapper -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <!-- HTTP client factory for testability -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <!-- Retry + circuit breaker for API calls -->
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

</Project>
